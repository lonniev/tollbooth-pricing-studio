<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The app DOES use encryption (AES-256-CBC, ChaCha20, Schnorr, ECDH, HKDF)
	  for Nostr DMs and identity proofs. However, this key is set to false
	  because BIS self-classification was filed 2026-04-27 under License
	  Exception TSU for publicly available source code (ECCN 5D002).
	  See bis-encryption/ for the filing documents.
	  Setting false allows TestFlight builds to auto-process without
	  manual compliance approval in App Store Connect.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tollbooth.dpyc.PricingStudio</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.tollbooth.dpyc.pricingstudio</string>
			</array>
		</dict>
	</array>
	<!--
	  Background DM notifications: `fetch` lets iOS opportunistically wake the
	  app to drain the relay and post local notifications while it is NOT the
	  foreground app. iOS controls the cadence (it is not real-time); the
	  registered BGAppRefreshTask identifier must be listed here.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.tollbooth.dpyc.PricingStudio.dmrefresh</string>
	</array>
</dict>
</plist>
